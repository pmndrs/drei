{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@ex/*": ["./src/*"],
      "@react-three/drei/core": ["../src/core"],
      "@react-three/drei/legacy": ["../src/legacy"],
      "@react-three/drei/webgpu": ["../src/webgpu"],
      "@react-three/drei/external": ["../src/external"],
      "@react-three/drei/experimental": ["../src/experimental"],
      "@react-three/drei": ["../src"],
      "three/webgpu": ["../node_modules/@types/three/build/three.webgpu.d.ts"],
      "three/tsl": ["../node_modules/@types/three/build/three.tsl.d.ts"],
      "#three": ["../node_modules/@types/three"],
      "#three-addons": ["../src/utils/three-addons"],
      "#drei-platform": ["../src/utils/drei-platform"],
      "@core/*": ["../src/core/*"],
      "@legacy/*": ["../src/legacy/*"],
      "@webgpu/*": ["../src/webgpu/*"],
      "@external/*": ["../src/external/*"],
      "@experimental/*": ["../src/experimental/*"],
      "@utils/*": ["../src/utils/*"],
      "@lib/*": ["../lib/*"]
    }
  },
  /* Only this app. drei's own source is typechecked by the root tsconfig, which
     has the correct #three -> @types/three mapping and drei's compiler options.
     Re-checking it here under different, stricter settings produced ~900 errors
     that were entirely configuration noise. See #2808. */
  "include": ["src"]
}
